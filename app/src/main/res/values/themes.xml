<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Suite theme (pUI) + pShare's own input and dialog components (values/styles.xml). -->
    <style name="AppTheme" parent="Theme.P">
        <item name="android:colorEdgeEffect">@color/accent</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:editTextStyle">@style/Input</item>
    </style>

    <style name="AppDialog" parent="Theme.P.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:buttonBarButtonStyle">@style/Button.Dialog</item>
        <item name="android:editTextStyle">@style/Input</item>
    </style>

    <!-- Receive screen: the camera fills the top, so the status bar goes black. -->
    <style name="AppTheme.Camera" parent="AppTheme">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
